---
import { conversationEn, conversationHi } from "../data/content";
import Icon from "./Icon.astro";
const blocks = [
  { lang: "en", label: "English", lines: conversationEn },
  { lang: "hi", label: "हिन्दी", lines: conversationHi },
] as const;
---
<div>
  <p class="mb-4 flex items-start gap-2 rounded-lg bg-teal-light px-4 py-3 text-sm text-ink">
    <Icon name="info" size={18} class="mt-0.5 shrink-0 text-teal-ink" />
    <span><strong>Illustrative example only.</strong> This is a written sample of how a conversation can be designed. It is not a recording of a real customer, and not a live demonstration.</span>
  </p>
  <div class="grid gap-6 md:grid-cols-2">
    {blocks.map((b) => (
      <figure class="rounded-xl border border-slate-200 bg-white p-5" lang={b.lang}>
        <figcaption class="mb-4 text-xs font-semibold tracking-wide text-muted-strong">{b.label}</figcaption>
        <ul class="space-y-3">
          {b.lines.map((l) => (
            <li class:list={["flex", l.from === "customer" ? "justify-start" : "justify-end"]}>
              <div class:list={["max-w-[88%] rounded-2xl px-4 py-2.5 text-[15px]", l.from === "customer" ? "rounded-bl-sm bg-mist text-ink" : "rounded-br-sm bg-navy text-white"]}>
                <span class:list={["mb-0.5 block text-[11px] font-semibold", l.from === "customer" ? "text-muted-strong" : "text-teal"]}>
                  {l.from === "customer" ? (b.lang === "hi" ? "ग्राहक" : "Customer") : (b.lang === "hi" ? "AI सहायक" : "AI assistant")}
                </span>
                {l.text}
              </div>
            </li>
          ))}
        </ul>
      </figure>
    ))}
  </div>
</div>
