---
interface Props { dark?: boolean; class?: string }
const { dark = false, class: className = "" } = Astro.props;
---
<span class:list={["inline-flex items-center gap-2.5", className]}>
  <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
    <circle cx="17" cy="17" r="14" stroke="#54C7B4" stroke-width="3"/>
    <rect x="11" y="14" width="2.6" height="6" rx="1.3" fill="#54C7B4"/>
    <rect x="15.7" y="10.5" width="2.6" height="13" rx="1.3" fill="#54C7B4"/>
    <rect x="20.4" y="13" width="2.6" height="8" rx="1.3" fill="#54C7B4"/>
  </svg>
  <span class="font-display text-[19px] font-extrabold leading-none tracking-tight" style={`color:${dark ? "#fff" : "#101D30"}`}>
    ORVANTA <span style="color:#54C7B4">CX</span>
  </span>
</span>
