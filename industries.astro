---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import CTASection from "../components/CTASection.astro";
import { industries } from "../data/content";
---
<BaseLayout
  title="AI Contact Centre Solutions Across Industries"
  description="See how ORVANTA CX applies AI voice and chat to e-commerce, real estate, SaaS, healthcare administration, travel and hospitality, and professional services."
  path="/industries"
  crumbs={[{ name: "Industries", path: "/industries" }]}
>
  <PageHero
    eyebrow="Industries"
    title="AI Contact Centre Solutions Across Industries."
    lead="Customers in every sector ask similar questions again and again. These are the areas where we can apply AI voice and chat. We do not claim existing clients in any of them."
    crumbs={[{ name: "Industries" }]}
  />

  <div class="py-6">
    {industries.map((i, idx) => (
      <section id={i.slug} class:list={["scroll-mt-20 py-14 sm:py-16", idx % 2 === 1 && "bg-mist"]}>
        <div class="wrap grid gap-8 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-navy text-teal"><Icon name={i.icon} size={24} /></span>
            <h2 class="mt-5 text-2xl font-extrabold sm:text-3xl">{i.name}</h2>
            <p class="mt-3 text-[17px] text-muted-strong">{i.summary}</p>
            <a href={`/contact?service=${encodeURIComponent(i.service)}&industry=${encodeURIComponent(i.slug)}`} class="btn btn-dark mt-6">Discuss {i.name}</a>
          </div>
          <div class="lg:col-span-7">
            <h3 class="text-lg font-bold">Typical use cases</h3>
            <ul class="mt-4 grid gap-x-6 gap-y-3 sm:grid-cols-2">
              {i.useCases.map((u) => <li class="flex gap-3 text-[15.5px]"><Icon name="check" size={18} class="mt-1 shrink-0 text-teal-ink" />{u}</li>)}
            </ul>
            {i.note && (
              <p class="mt-6 flex gap-3 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-[15px] text-amber-950" role="note">
                <Icon name="triangle-alert" size={18} class="mt-1 shrink-0" /><span>{i.note}</span>
              </p>
            )}
          </div>
        </div>
      </section>
    ))}
  </div>

  <CTASection />
</BaseLayout>
