---
import Icon from "./Icon.astro";
import type { Service } from "../data/services";
interface Props { service: Service; headingLevel?: "h2" | "h3"; showDescription?: boolean }
const { service: s, headingLevel: H = "h2", showDescription = true } = Astro.props;
const Sub = H === "h2" ? "h3" : "h4";
---
<div class="space-y-12">
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <H class="text-2xl font-extrabold sm:text-3xl">What the service does</H>
      {showDescription
        ? <p class="mt-4 text-[17px] text-muted-strong">{s.description}</p>
        : <p class="mt-4 text-[17px] text-muted-strong">In practice, this covers:</p>}
      <ul class="mt-6 grid gap-x-6 gap-y-3 sm:grid-cols-2">
        {s.capabilities.map((c) => (
          <li class="flex gap-3 text-[15.5px]"><Icon name="check" size={18} class="mt-1 shrink-0 text-teal-ink" /><span>{c}</span></li>
        ))}
      </ul>
      {s.caution && (
        <p class="mt-6 flex gap-3 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-[15px] text-amber-950" role="note">
          <Icon name="triangle-alert" size={18} class="mt-1 shrink-0" /><span>{s.caution}</span>
        </p>
      )}
    </div>
    <div class="space-y-8 lg:col-span-5">
      <div>
        <Sub class="text-lg font-bold">Who it suits</Sub>
        <ul class="mt-3 space-y-2 text-[15.5px] text-muted-strong">{s.suitableFor.map((x) => <li class="flex gap-3"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal"></span>{x}</li>)}</ul>
      </div>
      <div>
        <Sub class="text-lg font-bold">Typical use cases</Sub>
        <ul class="mt-3 space-y-2 text-[15.5px] text-muted-strong">{s.useCases.map((x) => <li class="flex gap-3"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal"></span>{x}</li>)}</ul>
      </div>
    </div>
  </div>

  <div>
    <Sub class="text-lg font-bold">How the process works</Sub>
    <ol class="mt-5 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
      {s.process.map((p, i) => (
        <li class="border-t border-slate-300 pt-4">
          <span class="font-display text-sm font-bold text-teal-ink">{String(i + 1).padStart(2, "0")}</span>
          <h4 class="mt-1 font-bold">{p.title}</h4>
          <p class="mt-1.5 text-[15px] text-muted-strong">{p.text}</p>
        </li>
      ))}
    </ol>
  </div>

  <div class="grid gap-10 md:grid-cols-2">
    <div>
      <Sub class="text-lg font-bold">Information we need from you</Sub>
      <ul class="mt-3 space-y-2 text-[15.5px] text-muted-strong">{s.clientInfo.map((x) => <li class="flex gap-3"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal"></span>{x}</li>)}</ul>
    </div>
    <div class="rounded-xl bg-teal-light/60 p-6">
      <Sub class="flex items-center gap-2 text-lg font-bold"><Icon name="user-check" size={20} class="text-teal-ink" />Human escalation approach</Sub>
      <ul class="mt-3 space-y-2 text-[15.5px] text-ink">{s.escalation.map((x) => <li class="flex gap-3"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-ink"></span>{x}</li>)}</ul>
    </div>
  </div>

  <div>
    <a href={`/contact?service=${encodeURIComponent(s.formValue)}`} class="btn btn-dark">Discuss {s.name}<Icon name="arrow-right" size={18} /></a>
  </div>
</div>
