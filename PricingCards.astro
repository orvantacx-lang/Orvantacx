---
import Icon from "./Icon.astro";
import { plans } from "../data/content";
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const list = compact ? plans.filter((p) => p.slug !== "enterprise") : plans;
---
<div class:list={["grid gap-5", compact ? "md:grid-cols-3" : "md:grid-cols-2 lg:grid-cols-4"]}>
  {list.map((p) => (
    <article class:list={["flex flex-col rounded-2xl border p-6", p.slug === "growth" ? "border-teal-ink bg-white shadow-[0_0_0_1px_#17776a]" : "border-slate-200 bg-white"]}>
      <h3 class="text-lg font-bold">{p.name}</h3>
      <p class="mt-3 font-display text-3xl font-extrabold text-ink">{p.price}</p>
      {p.priceSuffix && <p class="text-sm text-muted-strong">{p.priceSuffix}</p>}
      <p class="mt-4 text-[15px] text-muted-strong">{p.forWho}</p>
      {!compact && p.inclusions.length > 0 && (
        <ul class="mt-5 space-y-2 border-t border-slate-200 pt-5 text-[14.5px]">
          {p.inclusions.map((i) => <li class="flex gap-2.5"><Icon name="check" size={16} class="mt-1 shrink-0 text-teal-ink" />{i}</li>)}
        </ul>
      )}
      <a href={`/contact?plan=${encodeURIComponent(p.slug)}`} class:list={["btn mt-auto w-full", p.slug === "growth" ? "btn-dark" : "btn-outline", "!mt-6"]}>{p.cta}</a>
    </article>
  ))}
</div>
