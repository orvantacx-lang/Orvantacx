---
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { company } from "../data/site";

interface Props {
  title: string;
  seoTitle: string;
  description: string;
  path: string;
  intro: string;
  sections: { id: string; heading: string; body: string[] }[];
}
const { title, seoTitle, description, path, intro, sections } = Astro.props;
---
<BaseLayout title={seoTitle} description={description} path={path} crumbs={[{ name: title, path }]}>
  <PageHero eyebrow="Legal" title={title} lead={intro} crumbs={[{ name: title }]} />
  <section class="py-12 sm:py-16">
    <div class="wrap">
      <aside class="mb-10 flex gap-4 rounded-xl border border-amber-300 bg-amber-50 p-5 text-amber-950" role="note">
        <Icon name="triangle-alert" size={22} class="mt-0.5 shrink-0" />
        <p class="text-[15.5px]"><strong>Draft document.</strong> This {title} is a draft prepared for ORVANTA CX and has not been reviewed by a qualified lawyer. It must be reviewed, and adjusted for the laws that apply to the business and its clients, before it is relied on in production. Nothing here is a statement of legal compliance or certification.</p>
      </aside>
      <div class="grid gap-12 lg:grid-cols-12">
        <nav aria-label="On this page" class="lg:col-span-3">
          <p class="font-display text-sm font-bold">On this page</p>
          <ol class="mt-3 space-y-2 text-[14.5px] text-muted-strong lg:sticky lg:top-24">
            {sections.map((s, i) => <li><a class="hover:text-ink hover:underline" href={`#${s.id}`}>{i + 1}. {s.heading}</a></li>)}
          </ol>
        </nav>
        <article class="max-w-3xl space-y-10 lg:col-span-9">
          {sections.map((s, i) => (
            <section id={s.id} class="scroll-mt-24">
              <h2 class="text-xl font-extrabold sm:text-2xl">{i + 1}. {s.heading}</h2>
              <div class="mt-3 space-y-3 text-[16px] text-muted-strong">
                {s.body.map((p) => <p>{p}</p>)}
              </div>
            </section>
          ))}
          <p class="border-t border-slate-200 pt-6 text-sm text-muted-strong">Draft last prepared: November 2026. Contact: <a class="underline" href={`mailto:${company.email}`}>{company.email}</a></p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
