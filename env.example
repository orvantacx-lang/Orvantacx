# Build-time (public) settings. These end up in the built website, so never put secrets here.
# Copy to .env for local builds, or set in Cloudflare Pages → Settings → Variables and secrets.
SITE_URL=https://orvanta-cx.pages.dev
# Optional: Cloudflare Turnstile site key (public). Enables the Turnstile widget on the contact form.
PUBLIC_TURNSTILE_SITE_KEY=
# Optional: Google Search Console HTML-tag verification token (content value only).
PUBLIC_GOOGLE_SITE_VERIFICATION=
