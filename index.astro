---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import HeroVisual from "../components/HeroVisual.astro";
import FlowDiagram from "../components/FlowDiagram.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import PricingCards from "../components/PricingCards.astro";
import FAQ from "../components/FAQ.astro";
import CTASection from "../components/CTASection.astro";
import { capabilityStrip, voiceCapabilities, chatCapabilities, industries, whyPoints, homeProcess, faqs } from "../data/content";
import { company } from "../data/site";

const whatWeDo = [
  { icon: "phone-incoming", name: "AI Inbound Calling", text: "AI agents answer incoming calls, respond to approved questions, capture enquiries and route requests.", href: "/inbound-calling" },
  { icon: "phone-outgoing", name: "AI Outbound Calling", text: "AI agents support permitted follow-ups, appointment confirmations, reminders and lead qualification.", href: "/outbound-calling" },
  { icon: "message-square", name: "AI Chat Support", text: "AI chatbots respond to website visitors, answer common questions and capture customer enquiries.", href: "/ai-chat-support" },
  { icon: "headset", name: "AI Contact Centre Management", text: "A managed approach to customer interaction workflows, reporting, quality checks and human escalation.", href: "/how-we-work" },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<BaseLayout
  title="ORVANTA CX | AI-Powered BPO and Contact Centre in India"
  description="ORVANTA CX is an AI-powered BPO and contact centre in Lucknow, India. AI voice agents and chatbots handle routine customer conversations, with human escalation."
  path="/"
  jsonLd={[faqLd]}
>
  <!-- 1. Hero -->
  <section class="on-dark relative overflow-hidden bg-navy text-white">
    <div class="wrap grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-6">
        <p class="eyebrow mb-4 !text-teal text-[13px] uppercase tracking-[0.14em]">AI-Powered BPO &amp; Contact Centre</p>
        <h1 class="text-[2.2rem] font-extrabold !leading-[1.08] text-white sm:text-5xl lg:text-[3.4rem]">Every Customer Conversation. Handled Smarter.</h1>
        <p class="mt-6 max-w-xl text-[17px] text-white/75">
          ORVANTA CX helps businesses manage customer interactions through intelligent AI voice agents and chatbots. From inbound customer support to outbound follow-ups, lead qualification and appointment scheduling, we help businesses deliver consistent customer experiences with human support whenever it matters.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-primary">Get a Free Consultation</a>
          <a href="/services" class="btn btn-outline-light">Explore Our Services</a>
        </div>
      </div>
      <div class="lg:col-span-6"><HeroVisual /></div>
    </div>
  </section>

  <!-- 2. Capability strip -->
  <section aria-label="Capabilities" class="border-b border-slate-200 bg-white">
    <ul class="wrap grid grid-cols-2 gap-x-6 gap-y-6 py-8 lg:grid-cols-4">
      {capabilityStrip.map((c) => (
        <li class="flex items-start gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-teal-light text-teal-ink"><Icon name={c.icon} size={20} /></span>
          <div><p class="font-display text-[15px] font-bold leading-tight">{c.title}</p><p class="mt-0.5 text-[13.5px] text-muted-strong">{c.text}</p></div>
        </li>
      ))}
    </ul>
  </section>

  <!-- 3. What we do -->
  <section class="py-16 sm:py-24">
    <div class="wrap">
      <SectionHeading eyebrow="What we do" title="Customer Support That Works Around Your Business." lead="From incoming calls to online enquiries, ORVANTA CX helps businesses manage customer conversations through AI-powered voice and chat services." />
      <div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-slate-200 bg-slate-200 sm:grid-cols-2 lg:grid-cols-4">
        {whatWeDo.map((s) => (
          <article class="flex flex-col bg-white p-7">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-navy text-teal"><Icon name={s.icon} size={24} /></span>
            <h3 class="mt-5 text-lg font-bold">{s.name}</h3>
            <p class="mt-2 text-[15px] text-muted-strong">{s.text}</p>
            <a href={s.href} class="mt-5 inline-flex items-center gap-1.5 pt-1 text-[15px] font-semibold text-teal-ink hover:underline" style="margin-top:auto">Explore Service<Icon name="arrow-right" size={16} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. AI and humans -->
  <section class="bg-mist py-16 sm:py-24">
    <div class="wrap">
      <SectionHeading eyebrow="AI and people" title="AI Handles the Routine. People Handle the Important." lead="AI agents can manage approved, repetitive customer interactions efficiently. When a conversation becomes complex, sensitive or uncertain, the workflow can escalate it to an authorised human representative." />
      <div class="mt-12"><FlowDiagram /></div>
      <p class="mt-8 max-w-3xl text-[15.5px] text-muted-strong">Escalation routes and the availability of human representatives are agreed with each client before launch. If nobody is available at the time, the workflow can record a callback request instead of leaving the customer without a response.</p>
    </div>
  </section>

  <!-- 5. Voice and chat -->
  <section class="py-16 sm:py-24">
    <div class="wrap">
      <SectionHeading eyebrow="Capabilities" title="Voice and Chat, Configured Around Your Business." />
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <div class="on-dark rounded-2xl bg-navy p-8 text-white">
          <div class="flex items-center gap-3"><Icon name="audio-lines" size={26} class="text-teal" /><h3 class="text-xl font-bold !text-white">AI Voice Agents</h3></div>
          <ul class="mt-6 grid gap-x-6 gap-y-3 sm:grid-cols-2">
            {voiceCapabilities.map((c) => <li class="flex gap-2.5 text-[15px] text-white/85"><Icon name="check" size={17} class="mt-1 shrink-0 text-teal" />{c}</li>)}
          </ul>
          <a href="/ai-voice-solutions" class="mt-7 inline-flex items-center gap-1.5 text-[15px] font-semibold text-teal hover:underline">About AI voice solutions<Icon name="arrow-right" size={16} /></a>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-teal-light/50 p-8">
          <div class="flex items-center gap-3"><Icon name="message-square" size={26} class="text-teal-ink" /><h3 class="text-xl font-bold">AI Chatbots</h3></div>
          <ul class="mt-6 grid gap-x-6 gap-y-3 sm:grid-cols-2">
            {chatCapabilities.map((c) => <li class="flex gap-2.5 text-[15px]"><Icon name="check" size={17} class="mt-1 shrink-0 text-teal-ink" />{c}</li>)}
          </ul>
          <a href="/ai-chat-support" class="mt-7 inline-flex items-center gap-1.5 text-[15px] font-semibold text-teal-ink hover:underline">About AI chat support<Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Industries -->
  <section class="bg-mist py-16 sm:py-24">
    <div class="wrap">
      <SectionHeading eyebrow="Industries we support" title="Built for Conversations That Repeat." lead="These are sectors where customers ask similar questions every day. They describe where our services can be applied, not existing clients." />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {industries.map((i) => (
          <a href={`/industries#${i.slug}`} class="group rounded-xl border border-slate-200 bg-white p-6 transition-colors hover:border-teal-ink">
            <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-teal-light text-teal-ink"><Icon name={i.icon} size={22} /></span>
            <h3 class="mt-4 text-lg font-bold">{i.name}</h3>
            <p class="mt-2 text-[15px] text-muted-strong">{i.summary}</p>
            <p class="mt-4 flex flex-wrap gap-x-2 gap-y-1 text-[13px] text-muted-strong">{i.useCases.slice(0, 3).map((u) => <span class="rounded-full bg-mist px-2.5 py-0.5">{u}</span>)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Why -->
  <section class="py-16 sm:py-24">
    <div class="wrap">
      <SectionHeading eyebrow="Why ORVANTA CX" title="Customer Communication, Made More Manageable." />
      <div class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {whyPoints.map((w) => (
          <div>
            <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-navy text-teal"><Icon name={w.icon} size={22} /></span>
            <h3 class="mt-4 text-lg font-bold">{w.title}</h3>
            <p class="mt-2 text-[15.5px] text-muted-strong">{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Process -->
  <section class="on-dark bg-navy py-16 text-white sm:py-24">
    <div class="wrap">
      <div class="max-w-2xl">
        <p class="eyebrow mb-2">Our process</p>
        <h2 class="text-[1.65rem] font-extrabold !text-white sm:text-4xl">From First Conversation to Go-Live, Step by Step.</h2>
      </div>
      <div class="mt-12"><ProcessSteps steps={homeProcess} dark /></div>
      <a href="/how-we-work" class="btn btn-outline-light mt-12">See how we work</a>
    </div>
  </section>

  <!-- 9. Pricing preview -->
  <section class="py-16 sm:py-24">
    <div class="wrap">
      <SectionHeading eyebrow="Pricing" title="Indicative Starting Prices" lead="Prices are indicative and subject to scope and technical assessment. Setup, AI usage, telephony and other third-party costs may be charged separately." />
      <div class="mt-12"><PricingCards compact /></div>
      <div class="mt-5 flex flex-col items-start justify-between gap-4 rounded-2xl border border-dashed border-slate-300 p-6 sm:flex-row sm:items-center">
        <div><h3 class="text-lg font-bold">Enterprise Solutions</h3><p class="mt-1 text-[15px] text-muted-strong">Higher volumes, complex integrations, multiple regions or custom service levels. Custom quotation.</p></div>
        <a href="/contact?plan=enterprise" class="btn btn-outline shrink-0">Request a quotation</a>
      </div>
      <a href="/pricing" class="btn btn-dark mt-8">View full pricing details</a>
    </div>
  </section>

  <!-- 10. FAQ -->
  <section class="bg-mist py-16 sm:py-24">
    <div class="wrap grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4"><SectionHeading eyebrow="FAQ" title="Frequently Asked Questions" lead="Straight answers about what AI can and cannot do for your customer conversations." /></div>
      <div class="lg:col-span-8"><FAQ items={faqs} /></div>
    </div>
  </section>

  <!-- 11. Final CTA -->
  <CTASection
    text="Tell us about your customer support requirements. Our team will review your needs and discuss a suitable AI-powered contact centre solution."
    primary={{ label: "Discuss Your Requirements", href: "/contact" }}
    secondary={{ label: "Email " + company.email, href: "mailto:" + company.email }}
  />
</BaseLayout>
